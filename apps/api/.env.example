# Local PostgreSQL defaults. For Neon, use the root .env.local created by neon deploy
# instead of copying these defaults over it. DATABASE_URL_UNPOOLED is supported for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hhs
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hhs
PORT=4000
# Provisioning only; use a private local .env and never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
